rules_version = '2';

// Règles de sécurité Cloud Storage de Novaly.
// Déploiement : firebase deploy --only storage   (depuis novaly-launcher/)
// Au premier déploiement, la CLI demande d'autoriser Storage à lire Firestore (règles
// « cross-service », utilisées pour l'A2F) : répondre oui.
// Remarque : les liens de téléchargement avec "token=" (logo Discord, etc.) restent accessibles.
service firebase.storage {
  match /b/{bucket}/o {

    // Même règle que a2fValide() dans firestore.rules : si l'A2F est activée,
    // la session doit avoir été validée par un code.
    function a2fValide() {
      return !firestore.exists(/databases/(default)/documents/a2f_actif/$(request.auth.uid))
        || firestore.exists(/databases/(default)/documents/a2f_sessions/$(request.auth.uid)/ok/$(string(request.auth.token.auth_time)));
    }

    function connecte() {
      return request.auth != null && a2fValide();
    }

    // Avatars : chacun ne peut modifier que le sien (image de moins de 2 Mo)
    match /avatars/{fichier} {
      allow read: if request.auth != null;
      allow write: if connecte()
        && fichier == request.auth.uid + '.jpg'
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Sauvegardes cloud des jeux : saves/{uid}/{gameId}.zip, visibles par leur seul propriétaire
    match /saves/{uid}/{fichier} {
      allow read, delete: if connecte() && request.auth.uid == uid;
      allow create, update: if connecte() && request.auth.uid == uid
        && fichier.matches('[A-Za-z0-9_-][A-Za-z0-9_.-]*[.]zip')
        && request.resource.size < 100 * 1024 * 1024;
    }

    // Tout le reste : aucune écriture depuis les applications
    match /{tout=**} {
      allow read, write: if false;
    }
  }
}
