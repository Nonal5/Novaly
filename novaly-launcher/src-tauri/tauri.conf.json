{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Novaly",
  "version": "1.0.1",
  "identifier": "com.novaly.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Novaly",
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Nonal5/Novaly/releases/latest/download/latest.json"
      ],
      "pubkey": "/Users/noah/Desktop/Novaly/novaly-launcher/novaly.key.pub"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool"
  }
}