{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Novaly",
  "identifier": "com.novaly.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Novaly",
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
"plugins": {
    "deep-link": {
      "schemes": ["novaly"]
    },
    "updater": {
      "dialog": false,
      "endpoints": [
        "https://raw.githubusercontent.com/Nonal5/Novaly/main/novaly-launcher/src-tauri/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCQTJDNjlDQkIxRTI4NEMKUldSTUtCNjduTWFpTzFXUURWT29tbzBIOUFuNzJKdFJwaVE2Z0xPMXlOYnJOdGtoTGV6UVZsUEYK"
    }
  },
  "bundle": {
      "active": true,
      "targets": ["all"],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "category": "DeveloperTool"
    }
}